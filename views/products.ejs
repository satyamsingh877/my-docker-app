<%- include('layout', { body: `
  <h1 class="section-title">All Products</h1>

  <form class="filters" method="GET" action="/products">
    <input type="text" name="q" placeholder="Search products..." value="${filters.q}">
    <select name="category">
      <option value="all">All Categories</option>
      ${categories.map(c => `
        <option value="${c.category}" ${filters.category === c.category ? 'selected' : ''}>${c.category}</option>
      `).join('')}
    </select>
    <input type="number" name="min" placeholder="Min price" value="${filters.min}">
    <input type="number" name="max" placeholder="Max price" value="${filters.max}">
    <button type="submit" class="btn">Filter</button>
  </form>

  <div class="product-grid">
    ${products.length === 0 ? '<p>No products found.</p>' : products.map(p => `
      <div class="product-card">
        <img src="${p.image}" alt="${p.name}">
        <div class="info">
          <h3>${p.name}</h3>
          <p class="price">₹${p.price}</p>
          <span class="badge">${p.category}</span>
          <a href="/products/${p.id}" class="btn btn-sm">View</a>
        </div>
      </div>
    `).join('')}
  </div>
` }) %>
